{
  "name": "back-to-2000",
  "version": "0.4.3",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed:v0.2": "tsx scripts/append-v02-catalog-seed.ts",
    "db:seed:v0.3": "tsx scripts/generate-v03-game-migration.ts",
    "db:seed:v0.3.2": "tsx scripts/generate-v032-migration.ts",
    "images:games": "node scripts/fetch-game-images.mjs",
    "quality:catalog": "tsx scripts/audit-catalog-quality.ts",
    "quality:images": "tsx scripts/audit-image-quality.ts",
    "quality": "npm run lint && npm test && npm run quality:catalog && npm run quality:images",
    "cloudflare:types": "wrangler types worker-configuration.d.ts --config wrangler.production.jsonc",
    "cloudflare:backup": "node scripts/backup-d1.mjs",
    "cloudflare:verify-backup": "node scripts/verify-d1-backup.mjs",
    "cloudflare:migrate": "wrangler d1 migrations apply backto2000-production --remote --config wrangler.production.jsonc",
    "cloudflare:deploy": "npm run build && wrangler deploy --config wrangler.production.jsonc"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "framer-motion": "^13.1.0",
    "hono": "^4.13.1",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "miniflare": "^4.20260515.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
