{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "backto2000",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "backto2000.cloud",
      "custom_domain": true
    }
  ],
  "no_bundle": true,
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "backto2000-production",
      "database_id": "1ec88810-4b8a-423a-ad23-6585bb9fbb50",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "backto2000-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}
